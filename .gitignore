# ============================================
# RakshaSethu - Git Ignore
# ============================================

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
env/
.venv/
venv/
ENV/

# Python build/package files
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables / secrets
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/


# ----------------------------
# Node / React / Vite
# ----------------------------
node_modules/
dist/
dist-ssr/

# Local environment files
*.local

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ----------------------------
# GIS - Large / Raw Files
# ----------------------------

# Large raster files
*.tif
*.tiff
*.geotiff

# Shapefile components
*.shp
*.shx
*.dbf
*.prj

# GeoPackage
*.gpkg

# Raw data
data/raw/*
!data/raw/.gitkeep


# ----------------------------
# Processed Data
# ----------------------------

# Ignore processed data by default
data/processed/*

# Keep processed-data directories
!data/processed/
!data/processed/**/

# Allow useful processed datasets
!data/processed/**/*.csv
!data/processed/**/*.geojson
!data/processed/**/*.json

# Keep directory placeholders
!data/processed/**/.gitkeep

# Explicitly keep large raster/GeoPackage files ignored
data/processed/**/*.tif
data/processed/**/*.tiff
data/processed/**/*.geotiff
data/processed/**/*.gpkg


# ----------------------------
# Sample Data
# ----------------------------
data/sample/*
!data/sample/.gitkeep


# ----------------------------
# IDE
# ----------------------------
.idea/
.vscode/

# Editor temporary files
*.swp
*.swo
*.swn
*~


# ----------------------------
# Operating System
# ----------------------------
.DS_Store
Thumbs.db


# ----------------------------
# Logs
# ----------------------------
*.log


# ----------------------------
# Temporary / Scratch Files
# ----------------------------
scratch/